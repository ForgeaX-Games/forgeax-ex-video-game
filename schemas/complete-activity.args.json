{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-video:complete-activity args",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activityRevision",
    "artifactRefs",
    "checkIds"
  ],
  "properties": {
    "activityRevision": {
      "type": "integer",
      "minimum": 1
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "revision"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "assetRevision": {
            "type": "integer",
            "minimum": 0
          },
          "nodeRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "blueprintId",
                "nodeId"
              ],
              "properties": {
                "blueprintId": {
                  "type": "string",
                  "minLength": 1
                },
                "nodeId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          },
          "targetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "working",
              "ready",
              "failed"
            ]
          }
        }
      }
    },
    "checkIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notRequired": {
      "type": "boolean",
      "default": false
    },
    "suggestedFocus": {
      "$ref": "#/$defs/location"
    },
    "activity": {
      "enum": [
        "brief.collecting",
        "document.inquiry",
        "document.core",
        "document.pillar",
        "blueprint.outline",
        "characters.modeling",
        "characters.previewing",
        "scenes.modeling",
        "scenes.previewing",
        "rules.catalog",
        "rules.binding",
        "ui.authoring",
        "game.finalizing",
        "assets.character",
        "assets.scene",
        "video.presets.binding",
        "video.presets.validating",
        "playtest.validating"
      ],
      "description": "\u5e76\u53d1\u7ec4\u91cc\u5fc5\u987b\u6307\u660e\u662f\u54ea\u6761\u7ebf\uff1b\u7701\u7565\u5219\u56de\u843d\u5230\u7ec4\u5185\u4ee3\u8868\u6d3b\u52a8\u3002"
    },
    "requirementContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawIntent"
      ],
      "description": "\u4ec5 brief.collecting \u4f7f\u7528\u3002Host \u5f52\u4e00\u5316\u5e76\u622a\u65ad\u540e\u5199\u5165\u751f\u4ea7\u5e73\u9762\uff1b\u53ea\u5b58\u7ed3\u6784\u5316\u5b57\u6bb5\u4e0e\u539f\u59cb\u9996\u53e5\uff0c\u4e0d\u5b58\u6269\u5199\u5185\u5bb9\u3002",
      "properties": {
        "rawIntent": {
          "type": "string",
          "minLength": 1,
          "description": "\u4f5c\u8005\u7b2c\u4e00\u53e5\u539f\u6587\uff0c\u539f\u6837\u4fdd\u7559\u4e0d\u6539\u5199\u3002"
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "description": "\u4f5c\u8005\u8bed\u8a00\uff0c\u7f3a\u7701 zh-CN\u3002"
        },
        "visualStyle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dimensions": {
          "type": "object",
          "description": "\u516d\u7ef4\u9700\u6c42\uff0c\u6bcf\u7ef4\u8bb0\u5f55\u6765\u6e90\uff1aauthor \u4f5c\u8005\u660e\u8bf4 / inferred \u63a8\u65ad / default \u9ed8\u8ba4\u3002",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "source"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "author",
                  "inferred",
                  "default"
                ]
              }
            }
          }
        }
      }
    },
    "inquiryContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answers"
      ],
      "description": "仅 document.inquiry 使用。保存核心方案生成前的一次性补充问询，不生成独立文档。",
      "properties": {
        "answers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "answer"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "document",
            "blueprint",
            "rule",
            "ui",
            "asset",
            "play"
          ]
        },
        "documentType": {
          "type": "string",
          "enum": [
            "intake",
            "design-options",
            "core",
            "inquiry",
            "pillar"
          ]
        },
        "blueprintId": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "enum": [
            "entities",
            "variables",
            "formulas"
          ]
        },
        "itemId": {
          "type": "string"
        },
        "treeNodeId": {
          "type": "string"
        },
        "overlayId": {
          "type": "string"
        },
        "root": {
          "type": "string",
          "enum": [
            "character",
            "scene",
            "image",
            "video",
            "audio",
            "font"
          ]
        },
        "folderId": {
          "type": "string"
        },
        "entryId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
