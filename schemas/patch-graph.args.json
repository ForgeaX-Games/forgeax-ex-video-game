                          "of": { "type": "string", "minLength": 1 },
                          "on": { "enum": ["change", "inc", "dec"] }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type", "condition"],
                        "properties": { "type": { "const": "state" }, "condition": { "$ref": "#/$defs/graphCondition" } }
