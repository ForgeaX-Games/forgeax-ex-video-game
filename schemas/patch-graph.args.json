{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "game-video:patch-graph args",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ops"
  ],
  "$defs": {
    "cmpOp": {
      "enum": ["gte", "lte", "gt", "lt", "eq", "neq"]
    },
    "textValue": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": { "ref": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "graphClause": {
      "description": "One condition clause. Each variant is closed: no extra keys, no string dialect.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "varId", "op", "value"],
          "properties": {
            "type": { "const": "var" },
            "varId": { "type": "string", "minLength": 1 },
            "valueType": { "const": "number" },
            "op": { "$ref": "#/$defs/cmpOp" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "varId", "valueType", "op", "value"],
          "properties": {
            "type": { "const": "var" },
            "varId": { "type": "string", "minLength": 1 },
            "valueType": { "const": "text" },
            "op": { "enum": ["eq", "neq"] },
            "value": { "$ref": "#/$defs/textValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "varId", "equals"],
          "properties": {
            "type": { "const": "flag" },
            "varId": { "type": "string", "minLength": 1 },
            "equals": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "nodeId"],
          "properties": {
            "type": { "const": "visited" },
            "nodeId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "entityId", "attr", "op", "value"],
          "properties": {
            "type": { "enum": ["attr", "attrRatio"] },
            "entityId": { "type": "string", "minLength": 1 },
            "attr": { "type": "string", "minLength": 1 },
            "op": { "$ref": "#/$defs/cmpOp" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "left", "right", "attr", "op"],
          "properties": {
            "type": { "const": "attrCompare" },
            "left": { "type": "string", "minLength": 1 },
            "right": { "type": "string", "minLength": 1 },
            "attr": { "type": "string", "minLength": 1 },
            "op": { "$ref": "#/$defs/cmpOp" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "op", "value"],
          "properties": {
            "type": { "const": "score" },
            "op": { "$ref": "#/$defs/cmpOp" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "itemId"],
          "properties": {
            "type": { "const": "hasItem" },
            "itemId": { "type": "string", "minLength": 1 },
            "count": { "type": "number" }
          }
        }
      ]
    },
    "graphCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "description": "Always { all: [clause…] }. Never a string, never { any }. On a state reaction it belongs at when.condition, never at the reaction top level.",
      "properties": {
        "all": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphClause" }
        }
      }
    },
    "nodeAction": {
      "type": "object",
      "required": ["kind"],
      "description": "One do entry: effect / advance / spawn / hideOverlay. Payload shape is checked by runtime.shape.valid rather than here, because a malformed action degrades into a no-op instead of crashing the editor.",
      "properties": {
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "reactionTrigger": {
      "description": "Closed trigger set. A state trigger carries its condition at when.condition.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "enum": ["enter", "exit"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ms"],
          "properties": {
            "type": { "const": "at" },
            "ms": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "complete" },
            "if": { "$ref": "#/$defs/graphCondition" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "event" },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "condition"],
          "properties": {
            "type": { "const": "state" },
            "condition": { "$ref": "#/$defs/graphCondition" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "of"],
          "properties": {
            "type": { "const": "watch" },
            "of": { "type": "string", "minLength": 1 },
            "on": { "enum": ["change", "inc", "dec"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "of"],
          "properties": {
            "type": { "enum": ["shown", "hidden"] },
            "of": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "do"],
      "description": "Author SSOT: when → do. Exactly these two keys. A top-level condition key is the edge dialect (edge.data.condition) and is rejected here: state reactions write { when: { type: 'state', condition: { all: […] } }, do: […] }.",
      "properties": {
        "when": { "$ref": "#/$defs/reactionTrigger" },
        "do": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeAction" }
        }
      }
    },
    "nodeVideoGeneration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provider-resource-neutral Kino preset for this node. Holds author choices and platform asset ids only — never Kino resource ids, job state, or URLs; those are resolved at the user's explicit generate action. The prompt is NOT repeated here: media.prompt stays the single source of truth.",
      "required": [
        "schemaVersion",
        "durationSeconds",
        "generateAudio",
        "mode"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 4,
          "maximum": 15,
          "default": 8
        },
        "generateAudio": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "strict",
            "firstref",
            "ref",
            "t2v"
          ],
          "description": "strict needs first+last frame; firstref needs a first frame; ref needs at least one reference image; t2v needs none. The submission boundary validates the combination."
        },
        "size": {
          "type": "string",
          "enum": [
            "2560x1440",
            "1440x2560",
            "2496x1664",
            "1664x2496"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "720p",
            "1080p"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "visualStyleKey": {
          "type": "string",
          "minLength": 1,
          "description": "Exact key returned by list-video-visual-styles. Omit when no catalog style is selected; never invent or translate a style name."
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "description": "Logical references as platform asset ids, NOT Kino resource ids.",
          "properties": {
            "sceneAssetIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "firstFrameAssetId": {
              "type": "string",
              "minLength": 1
            },
            "lastFrameAssetId": {
              "type": "string",
              "minLength": 1
            },
            "extraImageAssetIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "nodeCast": {
      "type": "array",
      "description": "On-screen cast for this node. References characterId only — never copy a character's name or appearance text into the node.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "characterId"
        ],
        "properties": {
          "characterId": {
            "type": "string",
            "minLength": 1,
            "description": "Key in assets/manifest.json assetCatalog.entities.character. An unknown id fails validation; a character name is not an implicit reference."
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "supporting",
              "background"
            ]
          },
          "onScreen": {
            "type": "boolean",
            "default": true,
            "description": "false = mentioned in narration only; excluded from visual reference derivation."
          }
        }
      }
    },
    "nodeScenes": {
      "type": "array",
      "description": "Scene usage declarations for this node. blueprint.outline may assign stable sceneId values only; visual definitions and reference assets belong to the asset lane.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sceneId"
        ],
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "background"
            ]
          },
          "useAsVideoReference": {
            "type": "boolean"
          }
        }
      }
    },
    "nodeMedia": {
      "type": "object",
      "description": "Video authoring data. Every newly authored performance node should include a non-empty base prompt. Omit ref while the bundled placeholder is shown; after generation, set ref to the returned asset id and preserve prompt.",
      "required": [
        "kind",
        "prompt"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "video"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Base Kino prompt describing the shot, action, subject continuity, camera, lighting, and atmosphere."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Generated or existing video asset id. Omit before a real video is available; never write the UI placeholder URL here."
        },
        "generation": {
          "$ref": "#/$defs/nodeVideoGeneration"
        },
        "meta": {
          "type": "object"
        }
      }
    },
    "layoutValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:%|px)$"
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "description": "Absolute layout relative to the parent box. A stage-style mount whose child uses width:1,height:1 must explicitly carry { left:0, top:0, width:1, height:1 }; preserve any authored anchors or dimensions.",
      "properties": {
        "top": {
          "$ref": "#/$defs/layoutValue"
        },
        "right": {
          "$ref": "#/$defs/layoutValue"
        },
        "bottom": {
          "$ref": "#/$defs/layoutValue"
        },
        "left": {
          "$ref": "#/$defs/layoutValue"
        },
        "width": {
          "$ref": "#/$defs/layoutValue"
        },
        "height": {
          "$ref": "#/$defs/layoutValue"
        },
        "translateX": {
          "$ref": "#/$defs/layoutValue"
        },
        "translateY": {
          "$ref": "#/$defs/layoutValue"
        },
        "zIndex": {
          "type": "number"
        }
      }
    },
    "graphNode": {
      "type": "object",
      "description": "add-node、insert-node-after 和 insert-node-before 共用的节点结构。传入完整节点时 position { x, y } 必填。",
      "required": [
        "id",
        "type",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Usually \"perf\" for story beats."
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "description": "Canvas X. Main-graph chapters typically increment by ~240 per column."
            },
            "y": {
              "type": "number"
            }
          }
        },
        "data": {
          "$ref": "#/$defs/nodeAuthoringData"
        },
        "inputs": {
          "type": "array"
        },
        "outputs": {
          "type": "array"
        }
      }
    },
    "overlayNode": {
      "type": "object",
      "additionalProperties": false,
      "description": "A node-level mount of an overlay. ui.authoring is limited to existing base:* overlays by Host policy; game.finalizing may author the complete overlay structure. Configure prototype children through overrides keyed by childId; never write a children field. Stage-style mounts must include layout { left:0, top:0, width:1, height:1 }.",
      "required": [
        "overlay"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "overlay": {
          "type": "string",
          "minLength": 1,
          "description": "Overlay id. ui.authoring uses an exact base:* id; game.finalizing may reference or author any valid overlay id."
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "reactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reaction"
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "Sparse child patches keyed by an existing childId from the referenced base:* overlay."
        }
      }
    },
    "nodeAuthoringData": {
      "type": "object",
      "description": "Authoring fields on node data. A finished video beat carries chapterSummary, storyText, cast, and media with a base prompt plus generation preset. game.finalizing may configure the complete graph and overlay structure; activity-specific write policy is enforced by Host.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "chapterSummary": {
          "type": "string",
          "minLength": 1,
          "description": "Chapter/beat overview shown on the node card and used as production context."
        },
        "storyText": {
          "type": "string",
          "minLength": 1,
          "description": "Author-readable performance text: staging, dialogue, inner monologue, and the choices. The video is generated downstream from this. The field is storyText, never scriptText."
        },
        "cast": {
          "$ref": "#/$defs/nodeCast"
        },
        "scenes": {
          "$ref": "#/$defs/nodeScenes"
        },
        "media": {
          "$ref": "#/$defs/nodeMedia"
        },
        "overlayNodes": {
          "type": "array",
          "description": "Complete node overlay mount list. Use mount.layout plus overrides or the dedicated overlay ops; never overlayNodes[].children.",
          "items": {
            "$ref": "#/$defs/overlayNode"
          }
        },
        "reactions": {
          "type": "array",
          "description": "Node settlement reactions (when → do).",
          "items": {
            "$ref": "#/$defs/reaction"
          }
        },
        "outcomeEvidence": {
          "type": "array",
          "description": "目标节点对上游互动结果的结构化呈现证明；由 blueprint.outline 设计并冻结。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sourceEdgeId", "presentation"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sourceEdgeId": { "type": "string", "minLength": 1 },
              "presentation": { "type": "string", "minLength": 1 }
            }
          }
        },
        "interaction": {
          "type": "object",
          "description": "本节拍的玩法契约（总脉络必填，三条线共享的唯一玩法设计）。数值线读 effect.formulaId 决定造哪些公式，汇总整装照它挂元件、接结算、连出口。完成门：outline.interaction-plan / rules.plan-formulas / finalization.plan-wired。",
          "required": [
            "beat"
          ],
          "properties": {
            "beat": {
              "enum": [
                "narrative",
                "choice",
                "combat",
                "check",
                "timed"
              ],
              "description": "narrative = 有意的纯叙事段（观众只看，无需 actions）；其余四类必须给出 actions，否则判为漏配。"
            },
            "sourcePillarBeatId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,31}$",
              "description": "支柱文档互动节拍中的稳定 ID，例如 B01。所有非纯叙事玩法必须能追溯到作者确认的支柱设计。"
            },
            "narrativeIntent": {
              "type": "string",
              "minLength": 1,
              "description": "必须逐字复制支柱 beat.narrativeIntent；Host 用它防止总脉络只借 beat ID 重新发明玩法。"
            },
            "playerInformation": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "玩家在做决定前能够看到或推断的信息；没有信息的选择通常只是猜按钮。"
            },
            "actions": {
              "type": "array",
              "description": "观众在这个节拍能做的事，每条对应一个界面元件事件。",
              "items": {
                "type": "object",
                "required": [
                  "component",
                  "event",
                  "intent"
                ],
                "properties": {
                  "sourcePillarActionId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "必须命中 sourcePillarBeatId 下的 pillar action.id。"
                  },
                  "stateMutationOwner": {
                    "enum": ["none", "settlement"],
                    "description": "none 表示纯剧情分流；settlement 表示持久状态由目标结果节点的 at 结算修改。Host 会从 v2 支柱动作物化。"
                  },
                  "component": {
                    "type": "string",
                    "description": "界面元件 id，必须来自 list_ui_components。"
                  },
                  "event": {
                    "type": "string",
                    "description": "该元件能发的事件 id；它同时就是本节点的出口 handle（边的 sourceHandle 与它对齐）。"
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1,
                    "description": "一句话说明观众为什么会点它，用作者语言写；整装靠它判断该怎么配。"
                  },
                  "stateChangeIntent": {
                    "type": "string",
                    "minLength": 1,
                    "description": "逐字复制 pillar action.stateChange；effect 是它的具体规则 ID 编译结果。"
                  },
                  "feedback": {
                    "type": "string",
                    "minLength": 1,
                    "description": "当前节点中的即时反馈，例如血条下降、飘字、资源满值提示或按钮锁定。"
                  },
                  "feedbackSpec": {
                    "description": "把反馈文案编译成可机械核验的实际界面动作。",
                    "oneOf": [
                      {
                        "type": "object", "additionalProperties": false,
                        "required": ["kind", "component"],
                        "properties": { "kind": { "const": "transient-component" }, "component": { "type": "string", "minLength": 1 } }
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "required": ["kind", "component", "target"],
                        "properties": {
                          "kind": { "const": "state-binding" },
                          "component": { "type": "string", "minLength": 1 },
                          "target": { "type": "string", "minLength": 1 }
                        }
                      },
                      {
                        "type": "object", "additionalProperties": false,
                        "required": ["kind"],
                        "properties": { "kind": { "const": "hide-interface" } }
                      }
                    ]
                  },
                  "downstreamPayoff": {
                    "type": "string",
                    "minLength": 1,
                    "description": "目标视频节点必须呈现的剧情或动作结果。"
                  },
                  "exitIntent": {
                    "type": "string",
                    "minLength": 1,
                    "description": "逐字复制 pillar action.exitIntent。"
                  },
                  "effect": {
                    "type": "object",
                    "description": "这个动作改什么。纯分支动作（只跳转不改数值）可以省略。",
                    "required": [
                      "target",
                      "op"
                    ],
                    "properties": {
                      "target": {
                        "type": "string",
                        "description": "`entity.<实体id>.attr.<属性>` 或 `var.<变量id>`。"
                      },
                      "op": {
                        "enum": [
                          "add",
                          "sub",
                          "set"
                        ]
                      },
                      "formulaId": {
                        "type": "string",
                        "description": "期望数值线提供的公式名（例如 dmg_wusong_light）。这是给数值线下的订单，名字必须与它造出来的一致。"
                      },
                      "value": {
                        "type": "number",
                        "description": "不需要公式的定值改动。"
                      }
                    }
                  },
                  "exit": {
                    "type": "string",
                    "description": "这个动作要走的出边 sourceHandle；缺省即与 event 同名，填 'none' 表示只结算不离开节点（例如连击）。"
                  },
                  "targetNodeId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "exit 对应边的目标节点；用于校验界面事件与故事分支一致。"
                  }
                }
              }
            },
            "settlements": {
              "type": "array",
              "description": "系统触发而不是玩家直接点击的结算计划；每项都必须说明触发、反馈和分支。",
              "items": {
                "type": "object",
                "required": ["id", "pattern", "trigger", "intent", "source", "feedback"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "sourcePillarSettlementId": { "type": "string", "minLength": 1 },
                  "sourcePillarActionId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "可选：该结算承接的支柱动作 ID。数值动作必须先由组件事件进入结果节点，再由结果节点的 at 结算应用效果。"
                  },
                  "pattern": { "type": "string", "minLength": 1 },
                  "trigger": { "enum": ["at", "watch", "state"] },
                  "intent": { "type": "string", "minLength": 1 },
                  "source": { "type": "string", "minLength": 1 },
                  "triggerSpec": {
                    "description": "从支柱触发语义编译出的精确 runtime reaction.when。",
                    "anyOf": [
                      {
                        "type": "object",
