{
  "name": "@forgeax-extension/game-video",
  "version": "0.26.1",
  "description": "ForgeaX extension plugin — Video Game (gameplay-on-video) editor & player. 视频游戏（玩法优先）编辑器：Boss 战 / 血条 / QTE 闯关 / 限时·暂停选择 / 可点热点 + 视频分支（fork of reel）",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForgeaX-Games/forgeax-ex-video-game.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.3.13",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "forgeax-extension.json",
    "schemas",
    "README.md",
    "SKILL.md",
    "!dist/**/*.mp4",
    "dist/assets/placeholder-video.mp4",
    "!**/*.map",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./host": "./dist/server/host.js",
    "./package.json": "./package.json",
    "./styles.css": "./dist/index.css",
    "./standalone": "./dist/player/index.html"
  },
  "keywords": [
    "forgeax-plugin",
    "extension",
    "game-video",
    "video-game",
    "gameplay",
    "boss",
    "qte"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:standalone": "bun run build:backend && bun scripts/dev.ts --standalone",
    "dev:frontend": "vite --host",
    "dev:backend": "tsup --watch",
    "build": "bun run check && bun run build:frontend && bun run build:backend && bun run build:standalone && bun run check:release",
    "build:frontend": "tsc -p tsconfig.build.json && vite build",
    "build:backend": "tsup && node scripts/inline-react-flow-styles.mjs",
    "build:standalone": "tsc -p src/player/tsconfig.json && vite build --config src/player/vite.config.ts && node scripts/deduplicate-standalone-font.mjs",
    "build:nodia-seed": "bun scripts/build-nodia-seed.mjs",
    "start:standalone": "bun run build:standalone && vite preview --config src/player/vite.config.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && bun run check:biome && node scripts/check-module-boundaries.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "bun run lint && bun run check:i18n",
    "check:biome": "biome check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run --testTimeout=15000 --hookTimeout=15000 --maxWorkers=2",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "6.3.1",
    "@xyflow/react": "^12.10.2",
    "acorn": "^8.18.0",
    "ajv": "^8.17.1",
    "cos-js-sdk-v5": "^1.10.1",
    "eslint-scope": "8.4.0",
    "mammoth": "^1.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "@forgeax/extension-platform": "0.0.3",
    "@forgeax/extension-host": "^0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@forgeax/extension-platform": "0.0.3",
    "@forgeax/extension-host": "0.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
